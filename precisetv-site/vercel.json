{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/waitlist", "destination": "/waitlist.html" },
    { "source": "/demo", "destination": "/demo-video.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ]
}
